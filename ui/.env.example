# UI-side HTTP/WebSocket proxy target. No API token belongs in this file.
HARNESS_API_URL=http://127.0.0.1:18080

# Production UI container. All interfaces includes the host's Tailscale address.
UI_BIND_ADDRESS=0.0.0.0
UI_PORT=18081
HARNESS_UPSTREAM=http://host.docker.internal:18080
UI_DOCKER_SUBNET=172.16.1.0/24
