# start.sh and build.sh copy this file to .env when it is missing.
# Deployment settings only. Provider keys and runtime settings use the DB.
# Existing .env values are never replaced; exported values take precedence.

# true/1 = numbered read output; false/0 = plain-text control.
# Apply changes with: ./start.sh
MTT_READ_LINE_NUMBERS=true

# Optional synthetic model for local testing. Real providers are configured in the UI.
MTT_TEST_PROVIDER=false

# Published host ports. The UI also works through the host's LAN/Tailscale address.
# MTT_HOST_PORT=18080
# UI_PORT=18081
# UI_BIND_ADDRESS=0.0.0.0
# Native build.sh publishes PostgreSQL only on loopback at this port.
# MTT_POSTGRES_PORT=15432

# A host project parent directory, mounted read/write at /workspace.
# Relative paths are relative to this checkout. The selected directory must exist.
# MTT_WORKSPACE_DIR=./workspace

# Optional additional host mount at /host. On Linux, / exposes the host filesystem.
# Enable only when this access is wanted. File permissions still apply.
# MTT_HOST_ROOT=/

# start.sh uses your user/group IDs unless these are configured explicitly.
# MTT_UID=1000
# MTT_GID=1000
