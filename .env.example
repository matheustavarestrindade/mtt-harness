# mtt-harness environment. Copy to .env and fill the values.
MTT_PORT=8080
MTT_API_TOKEN=change-me
MTT_WORKSPACE=.
MTT_DATABASE_URL=postgres://mtt:mtt@localhost:5432/mtt?sslmode=disable
MTT_PROVIDER_NAME=openai
MTT_PROVIDER_API_URL=https://api.openai.com/v1
MTT_PROVIDER_MODEL_LIST_URL=https://api.openai.com/v1/models
MTT_PROVIDER_PRICE_TABLE_URL=
MTT_PROVIDER_API_KEY=
MTT_PROVIDER_REFRESH_HOURS=24
MTT_AGENT_DEPTH_LIMIT=2
